{
  "version": "0.2.1",
  "status": "design-only",
  "routes": [
    {
      "page": "login",
      "route": "/login",
      "roles": [
        "ANONYMOUS"
      ],
      "operations": [
        "login",
        "currentUser"
      ],
      "cases": [
        "B01"
      ]
    },
    {
      "page": "workspace",
      "route": "/app/conversations/:conversationId?",
      "roles": [
        "USER"
      ],
      "operations": [
        "listConversations",
        "getConversationSnapshot",
        "observeConversationEvents",
        "renameConversation",
        "submitFirstMessage",
        "submitConversationMessage",
        "cancelResponseExecution",
        "retryResponseExecution",
        "cancelTask",
        "respondInteraction",
        "reconcileOperation",
        "uploadArtifact",
        "downloadArtifact",
        "deleteConversation",
        "getArtifact",
        "getOperationDetail"
      ],
      "cases": [
        "B02",
        "B03",
        "B04",
        "B05",
        "B06",
        "B07",
        "B08",
        "B09",
        "B10",
        "B15"
      ]
    },
    {
      "page": "task",
      "route": "/app/tasks/:taskId",
      "roles": [
        "USER"
      ],
      "operations": [
        "getTask",
        "getConversationSnapshot"
      ],
      "cases": [
        "B04",
        "B05",
        "B09",
        "B10"
      ],
      "description": "旧地址只定位所属对话，不再提供普通任务详情工作台。"
    },
    {
      "page": "skills",
      "route": "/app/skills",
      "roles": [
        "USER"
      ],
      "operations": [
        "listSkills",
        "getSkillDetail",
        "importSkill",
        "setSkillGrant"
      ],
      "cases": [
        "B11"
      ]
    },
    {
      "page": "connections",
      "route": "/app/settings/connections",
      "roles": [
        "USER"
      ],
      "operations": [
        "listConnections",
        "createConnection",
        "updateConnection"
      ],
      "cases": [
        "B12"
      ]
    },
    {
      "page": "memory",
      "route": "/app/settings/memory",
      "roles": [
        "USER"
      ],
      "operations": [
        "listMemories",
        "createMemory",
        "updateMemory",
        "deleteMemory"
      ],
      "cases": [
        "B13"
      ]
    },
    {
      "page": "workers",
      "route": "/app/admin/workers",
      "roles": [
        "ADMIN"
      ],
      "operations": [
        "listWorkerDefinitions",
        "publishWorkerDefinition",
        "changeWorkerStatus"
      ],
      "cases": [
        "B14"
      ]
    }
  ],
  "conditionalPermissions": {
    "reconcileOperation": "OPERATOR_WITH_RESOURCE_SCOPE"
  },
  "nonPageActions": [
    "createConversation",
    "createTask",
    "getCommandReceipt",
    "getConversation",
    "getTaskSnapshot",
    "listConversationTasks",
    "listTaskArtifacts",
    "listTaskInteractions",
    "listTaskJobs",
    "listTaskOperations",
    "logout",
    "observeTaskEvents",
    "resumeTask"
  ]
}
