<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentsquad.squad.tools.operation.repository.OperationAccessMapper">

    <select id="countGrant" resultType="_int">
        SELECT COUNT(*) FROM sq_operation_reconciler
        WHERE user_id = #{userId} AND scope_id = #{scopeId} AND del_flag = '0'
    </select>
</mapper>
