# 本机 Java 服务连接 Docker MySQL；不要在此文件填写真实密钥。
SQUAD_DB_URL=jdbc:mysql://127.0.0.1:13306/agent_squad
SQUAD_DB_USER=squad
SQUAD_DB_PASSWORD=

# 本地登录账号；当前会话保存在进程内，重启服务后需重新登录。
SQUAD_LOCAL_USER=
SQUAD_LOCAL_PASSWORD=

# 默认不执行模型任务；启用后必须同时填写下方三项。
SQUAD_DELIVERY_ENABLED=false
SQUAD_MODEL_API_KEY=
SQUAD_MODEL_BASE_URL=
SQUAD_MODEL_NAME=
