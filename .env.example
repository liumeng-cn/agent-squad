# 本机 Java 服务连接 Docker MySQL；不要在此文件填写真实密钥。
SQUAD_DB_URL=jdbc:mysql://127.0.0.1:13306/agent_squad
SQUAD_DB_USER=squad
SQUAD_DB_PASSWORD=

# 网关连接业务服务；Vite页面默认代理到127.0.0.1:18081。
SQUAD_BUSINESS_SERVICE_URL=http://127.0.0.1:18080

# 本地登录账号；网关会话保存在进程内，重启网关后需重新登录。
SQUAD_LOCAL_USER=
SQUAD_LOCAL_ROLE=ADMIN
SQUAD_LOCAL_PASSWORD=

# 连接密钥保险库主密钥：openssl rand -base64 32 生成；不设置则无法保存连接密钥。
SQUAD_CONNECTION_SECRET_KEY=

# 默认不执行模型任务；启用后必须同时填写下方三项。
SQUAD_DELIVERY_ENABLED=false
SQUAD_MODEL_API_KEY=
SQUAD_MODEL_BASE_URL=
SQUAD_MODEL_NAME=

# 同一用户所有回复和任务的累计预算上限（整数微单位，不随新会话或转任务重置）
SQUAD_BUDGET_MAX_MICROUNITS_PER_USER=50000000

# 单条回复及其后续目标共享的账户额度（整数微单位）
SQUAD_BUDGET_MAX_MICROUNITS_PER_RESPONSE=5000000
