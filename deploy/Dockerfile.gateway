# 先在外部构建 jar，再生成独立镜像；不在镜像内注入密钥。
FROM eclipse-temurin:27-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 squad
WORKDIR /srv
COPY server/agent-squad-gateway/target/agent-squad-gateway-0.1.0-SNAPSHOT.jar app.jar
USER 10001
EXPOSE 18081
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75"
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:18082/actuator/health/readiness || exit 1
ENTRYPOINT ["java","-jar","/srv/app.jar"]
